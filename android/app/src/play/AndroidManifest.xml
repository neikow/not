<?xml version="1.0" encoding="utf-8"?>
<!--
  Merged over the main manifest in Play builds only (-Pstore=play, see build.gradle.kts).
  Play keeps USE_EXACT_ALARM for alarm clock and calendar apps, so Play builds ask for
  SCHEDULE_EXACT_ALARM instead: the user allows it from Settings → Reminders, and until then
  reminders use inexact alarms (a few minutes late at worst). Sideloaded builds keep
  USE_EXACT_ALARM, granted at install.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.USE_EXACT_ALARM"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:remove="android:maxSdkVersion" />
</manifest>
