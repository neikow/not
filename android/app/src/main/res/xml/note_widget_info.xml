<?xml version="1.0" encoding="utf-8"?>
<!-- Placing it asks which note to show; long-press the widget to pick another. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="dev.lysen.not.widget.WidgetSetupActivity"
    android:widgetFeatures="reconfigurable"
    android:description="@string/widget_note_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="80dp"
    android:previewLayout="@layout/widget_note_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="3"
    android:targetCellHeight="3"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
