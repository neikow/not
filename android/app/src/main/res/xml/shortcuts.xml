        android:icon="@drawable/ic_shortcut_add_task"
        android:shortcutId="add_task"
        android:shortcutShortLabel="@string/add_task">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="dev.lysen.not.QuickAddActivity"
            android:targetPackage="dev.lysen.not" />
    </shortcut>
</shortcuts>
