<?xml version="1.0" encoding="utf-8"?>
<!-- Re-rendered every 30 minutes and on every change; its text never goes stale in between. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="dev.lysen.not.widget.WidgetSetupActivity"
    android:widgetFeatures="reconfigurable"
    android:description="@string/widget_timed_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:previewLayout="@layout/widget_timed_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen|keyguard" />
