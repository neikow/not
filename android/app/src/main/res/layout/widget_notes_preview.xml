<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows (Android 12+): a static stand-in for the Glance widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_notes"
            android:textColor="@color/widget_preview_content"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_preview_add"
            android:importantForAccessibility="no"
            android:padding="7dp"
            android:src="@drawable/ic_add"
            android:tint="@color/widget_preview_on_accent" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@drawable/widget_preview_card"
        android:paddingHorizontal="12dp"
        android:paddingVertical="9dp"
        android:text="@string/widget_preview_note_1"
        android:textColor="@color/widget_preview_content"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@drawable/widget_preview_card"
        android:paddingHorizontal="12dp"
        android:paddingVertical="9dp"
        android:text="@string/widget_preview_note_2"
        android:textColor="@color/widget_preview_content"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@drawable/widget_preview_card"
        android:paddingHorizontal="12dp"
        android:paddingVertical="9dp"
        android:text="@string/widget_preview_note_3"
        android:textColor="@color/widget_preview_content"
        android:textSize="15sp" />
</LinearLayout>
