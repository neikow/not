<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows (Android 12+): a static stand-in for the Glance widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_ring"
            android:tint="@color/widget_preview_accent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_preview_timed_title"
                android:textColor="@color/widget_preview_content"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_preview_timed_state"
                android:textColor="@color/widget_preview_faint"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/widget_preview_pill"
        android:gravity="center"
        android:text="@string/widget_preview_timed_button"
        android:textColor="@color/widget_preview_on_accent"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
