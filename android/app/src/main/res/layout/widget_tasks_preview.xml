<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows (Android 12+): a static stand-in for the Glance widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_task_alt"
            android:tint="@color/widget_preview_content" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/widget_preview_list"
            android:textColor="@color/widget_preview_content"
            android:textSize="18sp" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_add"
            android:tint="@color/widget_preview_content" />
    </LinearLayout>

    <CheckBox
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="@color/widget_preview_content"
        android:text="@string/widget_preview_task_1"
        android:textColor="@color/widget_preview_content" />

    <CheckBox
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="@color/widget_preview_content"
        android:text="@string/widget_preview_task_2"
        android:textColor="@color/widget_preview_content" />

    <CheckBox
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="@color/widget_preview_content"
        android:text="@string/widget_preview_task_3"
        android:textColor="@color/widget_preview_content" />
</LinearLayout>
